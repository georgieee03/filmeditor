+def _media_stream_indices(payload: ProbePayload) -> dict[str, int]:
+    """Pin absolute decoder streams; avformat-novalidate does not select them."""
+    streams = payload.get("streams", [])
+    if not streams:
+        raise ToolError("Media has no readable streams for decoder selection.")
+    def selected_index(kind: str) -> int:
+        candidates = []
+        for stream in streams:
+            disposition = stream.get("disposition", {})
+            attached = is_object(disposition) and disposition.get("attached_pic") in (1, True)
+            if stream.get("codec_type") == kind and not (kind == "video" and attached):
+                candidates.append(stream)
+        if not candidates:
+            return -1
+        selected = next((stream for stream in candidates if is_object(stream.get("disposition"))
+                         and stream["disposition"].get("default") in (1, True)), candidates[0])
+        index = selected.get("index")
+        if type(index) is not int or index < 0:
+            raise ToolError(f"The selected {kind} stream has no readable absolute index.")
+        return index
+    return {"video_index": selected_index("video"), "audio_index": selected_index("audio")}
 
 
